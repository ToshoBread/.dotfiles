{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/MiMo V2.5 Free",
  "shell": "/bin/zsh",
  "autoupdate": "notify",
  "lsp": true,
  "formatter": true,
  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/*": "allow",
    },
  },
  "mcp": {
    "excalidraw": {
      "type": "local",
      "command": ["pnpm", "dlx", "@scofieldfree/excalidraw-mcp"],
      "enabled": false,
    },
  },
}
